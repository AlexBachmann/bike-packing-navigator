# ==========================================
# Route Data Pipeline & Large Datasets
# ==========================================
# Downloaded 3D DEM rasters, hillshades, contours (e.g. 2GB+ Copernicus DEM)
route/terrain/
*.tif
*.tiff
*.vrt
*.gpkg

# OpenStreetMap binary extract dumps (80MB+)
*.osm.pbf
*.pbf

# Google Places API & Overpass persistent request caches
route/places/.cache*
*.cache_places_api*.json
*.cache_overpass*.json
*.cache.json

# Tour Divide full corridor master archive (>100MB exceeds GitHub limit; sliced into section-1..4.pmtiles)
public/data/routes/tour-divide-2025/corridor.pmtiles

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
*.env
!.env.example
!.env.sample

# Docker Compose overrides (local secrets & configs)
compose.override.yml
compose.*.override.yml
docker-compose.override.yml
docker-compose.*.override.yml

